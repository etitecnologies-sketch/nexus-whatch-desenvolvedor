# --- CONFIGURAÇÃO OBRIGATÓRIA (BACKEND) ---
DATABASE_URL="mysql://usuario:senha@host:porta/banco"
JWT_SECRET="etitenologies"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"

# --- CONFIGURAÇÃO OBRIGATÓRIA (FRONTEND - BUILD TIME) ---
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_anon_public_key_aqui"
VITE_APP_TITLE="Nexus Watch - ETI Technologies"
VITE_APP_LOGO="https://your-domain.com/logo.png"

# --- CONFIGURAÇÕES OPCIONAIS (MAPAS/FORGE) ---
VITE_FRONTEND_FORGE_API_KEY="your_key"
VITE_FRONTEND_FORGE_API_URL="https://api.your-domain.com"
BUILT_IN_FORGE_API_URL="https://api.your-domain.com"
BUILT_IN_FORGE_API_KEY="your_key"

# --- ANALYTICS ---
VITE_ANALYTICS_ENDPOINT="https://analytics.your-domain.com"
VITE_ANALYTICS_WEBSITE_ID="your_id"

# --- AMBIENTE ---
NODE_ENV="production"
PORT=3000

# --- MONITORAMENTO (monitoring-system02 migrado) ---
# Banco TimescaleDB/Postgres para métricas/alerts/triggers/clients/solar
MONITORING_DATABASE_URL="postgres://user:password@host:5432/monitoring"
# CORS do módulo de monitoramento
MONITORING_CORS_ORIGIN="*"
# Processor (offline/ping/triggers + notificações)
MONITORING_PROCESSOR_ENABLED="false"
MONITORING_EVAL_INTERVAL="3"
MONITORING_OFFLINE_TIMEOUT="60"
MONITORING_ALERT_COOLDOWN="120"
MONITORING_PING_ENABLED="false"
MONITORING_PING_TIMEOUT="3"
MONITORING_PING_COUNT="1"
# Notificações
MONITORING_TELEGRAM_TOKEN=""
MONITORING_TELEGRAM_CHAT_ID=""
MONITORING_SMTP_HOST=""
MONITORING_SMTP_PORT="587"
MONITORING_SMTP_USER=""
MONITORING_SMTP_PASS=""
MONITORING_ALERT_EMAIL=""

# --- n8n (hub de notificações) ---
N8N_WEBHOOK_URL="https://seu-n8n.com/webhook/nexus-alert"
N8N_WEBHOOK_SECRET="segredo_forte"

# WhatsApp (variáveis usadas no n8n, se você for mandar WhatsApp pelo workflow)
EVOLUTION_API_URL="https://sua-evolution.com"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="nexus"
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
WHATSAPP_NUMBERS="5511999999999"
